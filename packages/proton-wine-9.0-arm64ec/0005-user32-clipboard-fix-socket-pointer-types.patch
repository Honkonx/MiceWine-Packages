From: MiceWine <micewine@localhost>
Subject: user32: Fix pointer types in Android clipboard socket calls

El codigo de clipboard Android de Pipetto (dlls/user32/clipboard.c, commit propio
de su rama proton-9.0-arm64ec) pasa int*/void* directo a send()/recv(), cuyos
prototipos Winsock declaran const char* y char* respectivamente.

GCC lo aceptaba con warning. clang lo trata como ERROR
(-Wincompatible-pointer-types), asi que al cambiar el toolchain PE a llvm-mingw
(necesario para arm64ec, ver el comentario de --with-mingw en build.sh) el build
muere en:

  ../dlls/user32/clipboard.c:71:22: error: incompatible pointer types passing
      int * to parameter of type const char *
  make: *** [Makefile:137123: dlls/user32/aarch64-windows/clipboard.o] Error 1

Fix: casts explicitos (const char * para send, char * para recv). Es lo correcto
y estandar para mandar enteros crudos por socket -- no cambia una sola instruccion
generada, solo callaba el chequeo de tipos.

Se agrega ademas (void) al prototipo de receive_android_clipboard_data(), que
estaba declarada sin parametros al estilo K&R (clang moderno lo marca con
-Wdeprecated-non-prototype).

--- a/dlls/user32/clipboard.c
+++ b/dlls/user32/clipboard.c
@@ -68,22 +68,22 @@
 	net_requestcode = htonl(clipboard_data.request_code);
 	net_data_format = htonl(clipboard_data.format);
 	net_data_size = htonl(clipboard_data.size);
-	ret = send(sock_fd, &net_requestcode, sizeof(net_requestcode), 0);
+	ret = send(sock_fd, (const char *)&net_requestcode, sizeof(net_requestcode), 0);
 	if (ret == SOCKET_ERROR) {
 		TRACE( "Failed to send request code\n" );
 		return 0;
 	}
-	ret = send(sock_fd, &net_data_format, sizeof(net_data_format), 0);
+	ret = send(sock_fd, (const char *)&net_data_format, sizeof(net_data_format), 0);
 	if (ret == SOCKET_ERROR) {
 		TRACE( "Failed to send Windows clipboard data format\n" );
 		return 0;
 	}
-	ret = send(sock_fd, &net_data_size, sizeof(net_data_size), 0);
+	ret = send(sock_fd, (const char *)&net_data_size, sizeof(net_data_size), 0);
 	if (ret == SOCKET_ERROR) {
 		TRACE( "Failed to send Windows clipboard data size\n" );
 		return 0;
 	}
-	ret = send(sock_fd, clipboard_data.data, clipboard_data.size, 0);
+	ret = send(sock_fd, (const char *)clipboard_data.data, clipboard_data.size, 0);
 	if (ret == SOCKET_ERROR) {
 		TRACE( "Failed to send Windows clipboard data\n" );
 		return 0;
@@ -100,7 +100,7 @@
 	return 1;
 }
 
-static android_clipboard_data_t receive_android_clipboard_data() {
+static android_clipboard_data_t receive_android_clipboard_data(void) {
     WSADATA data;
     android_clipboard_data_t clipboard_data = {0};
     SOCKET sock_fd;
@@ -129,15 +129,15 @@
 	clipboard_data.request_code = 3;
 	net_requestcode = htonl(clipboard_data.request_code);
 	
-	ret = send(sock_fd, &net_requestcode, sizeof(net_requestcode), 0);
+	ret = send(sock_fd, (const char *)&net_requestcode, sizeof(net_requestcode), 0);
 	if (ret == SOCKET_ERROR) {
 		TRACE( "Failed to send request code\n" );
 	}
-    ret = recv(sock_fd, &net_data_format, sizeof(net_data_format), 0);
+    ret = recv(sock_fd, (char *)&net_data_format, sizeof(net_data_format), 0);
     if (ret == SOCKET_ERROR) {
     	TRACE( "Failed to receive Android clipboard data format\n" );
     }
-    ret = recv(sock_fd, &net_data_size, sizeof(net_data_size), 0);
+    ret = recv(sock_fd, (char *)&net_data_size, sizeof(net_data_size), 0);
     if (ret == SOCKET_ERROR) {
     	TRACE( "Failed to receive Android clipboard data size\n" );
     }
@@ -146,7 +146,7 @@
     clipboard_data.size = ntohl(net_data_size);
     clipboard_data.data = malloc(clipboard_data.size);
     
-    ret = recv(sock_fd, clipboard_data.data, clipboard_data.size, 0);
+    ret = recv(sock_fd, (char *)clipboard_data.data, clipboard_data.size, 0);
     if (ret == SOCKET_ERROR) {
     	TRACE( "Failed to receive Android clipboard data\n" );
     }
